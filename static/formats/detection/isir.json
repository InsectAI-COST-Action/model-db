        "model" : {
            "name"  : "? : T[string]",
            "uuid" : "? : T[UUIDv4]"
        },
        "prediction" : {
            "timestamp" : "? : T[ISO]",
            "config"    : "? : T[obj]"
        },
        "context" : {
            "timestamp" : "? : T[ISO]",
            "longitude" : "? : T[float]",
